@namespace CM.Shared
@inherits LoggedInUser_Base

<div class="loggedin-user" @onkeydown="HandleKeyDown">
    @if(_isHydrated) {
        <button type="button"
                class="user-trigger"
                @onclick="ToggleOpen"
                aria-haspopup="menu"
                aria-expanded="@(_isOpen ? "true" : "false")"
                title="Account">
            <span class="user-name">@_userName</span>
            <svg class="person-icon" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="8" r="4" />
                <path d="M4 21c0-4.4 3.6-7 8-7s8 2.6 8 7" />
            </svg>
        </button>

        @if(_isOpen) {
            <!-- Click anywhere outside to close -->
            <div class="user-menu-backdrop" @onclick="Close"></div>

            <ul class="user-menu" role="menu">
                <li role="menuitem">
                    <button type="button" class="user-menu-item" @onclick="OnThemeAsync">Theme</button>
                </li>
                @* Nothing to log out of while sign-in is switched off. *@
                @if(CMSettings.RequireSignIn) {
                    <li role="menuitem">
                        <button type="button" class="user-menu-item" @onclick="OnLogoutAsync">Logout</button>
                    </li>
                }
            </ul>
        }
    } else {
        <span class="user-skeleton" aria-hidden="true"></span>
    }
</div>
